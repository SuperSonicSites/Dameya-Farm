---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import PhotoPlaceholder from '../../components/PhotoPlaceholder.astro';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('updates', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.excerpt} ogType="article">
  <article class="section">
    <Container narrow>
      <a class="back-link" href="/updates/">← Back to updates</a>
      <div class="post-date">{formatDate(post.data.date)}</div>
      <h1 class="post-title">{post.data.title}</h1>
      {
        post.data.photo && (
          <PhotoPlaceholder label={post.data.photo} class="post-photo" />
        )
      }
      <div class="post-body">
        <Content />
      </div>
    </Container>
  </article>
</BaseLayout>

<style>
  .back-link { font-size: 0.95rem; font-weight: 600; }
  .post-date {
    font-size: var(--text-small);
    color: var(--ink-soft);
    margin: var(--space-6) 0 var(--space-1);
  }
  .post-title { margin: 0 0 var(--space-6); }
  .post-photo { margin-bottom: var(--space-6); }
  /* Long-form body: constrain measure and give paragraphs comfortable rhythm. */
  .post-body :global(p) { max-width: var(--measure); }
  .post-body :global(h2),
  .post-body :global(h3) { margin-top: var(--space-8); }
  .post-body :global(ul),
  .post-body :global(ol) { max-width: var(--measure); padding-left: var(--space-6); }
  .post-body :global(img) {
    border-radius: var(--radius-card);
    margin-block: var(--space-6);
  }
</style>
