---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
---

<BaseLayout
  title="Thank you"
  description="Thanks for getting in touch with Dameya Farm — we'll be back to you soon."
>
  <section class="section">
    <Container narrow>
      <Card tint="green" class="thanks-card">
        <h1 class="thanks-card__title">Thanks — we got your message.</h1>
        <p class="thanks-card__lead">
          We'll get back to you as soon as we can. If it's time-sensitive, you can
          also reach us by email or phone.
        </p>
        <div class="thanks-card__actions">
          <Button href="/">Back to home</Button>
          <Button variant="secondary" href="/updates/">Read the latest updates</Button>
        </div>
      </Card>
    </Container>
  </section>
</BaseLayout>

<style>
  .thanks-card { padding: var(--space-8); }
  .thanks-card__title { margin: 0 0 var(--space-4); }
  .thanks-card__lead { margin: 0 0 var(--space-6); }
  .thanks-card__actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
</style>
