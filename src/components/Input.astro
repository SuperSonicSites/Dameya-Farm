---
// Labeled text input.
type InputType = astroHTML.JSX.HTMLInputTypeAttribute;
interface Props {
  label: string;
  name: string;
  hint?: string;
  type?: InputType;
  required?: boolean;
  placeholder?: string;
  class?: string;
}
const {
  label,
  name,
  hint,
  type = 'text',
  required = false,
  placeholder,
  class: className,
} = Astro.props as Props;
const id = `field-${name}`;
---

<div class={className}>
  <label class="field-label" for={id}>
    {label}
    {hint && <span class="field-label__hint"> — {hint}</span>}
  </label>
  <input
    class="field-control"
    id={id}
    name={name}
    type={type}
    required={required}
    placeholder={placeholder}
  />
</div>
