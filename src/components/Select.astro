---
// Labeled select.
interface Props {
  label: string;
  name: string;
  options?: string[];
  class?: string;
}
const { label, name, options = [], class: className } = Astro.props;
const id = `field-${name}`;
---

<div class={className}>
  <label class="field-label" for={id}>{label}</label>
  <select class="field-control" id={id} name={name}>
    {options.map((o) => <option value={o}>{o}</option>)}
  </select>
</div>
